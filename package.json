{
  "name": "zalo-connector",
  "version": "2.5.0",
  "description": "Zalo personal account connector (zca-js): OpenClaw extension + MCP server for ChatGPT and other MCP clients. Login via QR code.",
  "type": "module",
  "main": "./index.ts",
  "bin": {
    "zalo-mcp": "./bin/zalo-mcp.mjs"
  },
  "author": "hiro-pna (fork of caochitam/zalo-personal)",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-extension",
    "zalo",
    "zalo-personal",
    "vietnam",
    "messaging",
    "chatbot",
    "qr-login",
    "mcp",
    "chatgpt",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiro-pna/zalo-connector.git"
  },
  "bugs": {
    "url": "https://github.com/hiro-pna/zalo-connector/issues"
  },
  "homepage": "https://github.com/hiro-pna/zalo-connector#readme",
  "files": [
    "bin/",
    "src/",
    "script/",
    "README.md",
    "INSTALL.md",
    "QUICK-REFERENCE.vi.md",
    "LICENSE",
    "quick-install.sh",
    "config-helper.cjs",
    "openclaw.plugin.json",
    "index.ts",
    "zalo-group.jpg",
    "momo-caochitam.jpg"
  ],
  "scripts": {
    "mcp": "node bin/zalo-mcp.mjs serve",
    "login": "node bin/zalo-mcp.mjs login"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "openclaw": ">=2026.2.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sinclair/typebox": "0.34.48",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "zca-js": "^2.1.0",
    "zod": "^4.3.6"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "zalo-personal",
      "label": "Zalo Personal",
      "selectionLabel": "Zalo Personal Account",
      "docsPath": "/channels/zalo-personal",
      "docsLabel": "zalo-personal",
      "blurb": "Zalo personal account via zca-js library (no CLI needed).",
      "aliases": [
        "zp"
      ],
      "order": 86,
      "quickstartAllowFrom": true
    },
    "install": {
      "localPath": "extensions/zalo-personal",
      "defaultChoice": "local"
    }
  }
}
